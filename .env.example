# AImail server-side environment (Lanes A, B, C). The backend AND the listener read this one file.
# Copy to .env and fill locally; never commit real values (.env is gitignored).
# Lane D (frontend) has its OWN public env — never copy any secret below into it (it ships to the browser).

# ===== Lane A — listener (Gmail + Pub/Sub -> PII mask -> Supabase) =====
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Deadline on the listener's PostgREST writes. Without one a hung connection blocks the
# Pub/Sub receive callback indefinitely, which matters here because DNS resolves via Tailscale.
SUPABASE_TIMEOUT_SECONDS=10
# JiaJun: add your Gmail OAuth + Pub/Sub vars here (project id, subscription, credentials path).
# Presidio NER masking (docker-compose up). Optional — listener degrades to regex-only if unset/down.
PRESIDIO_ANALYZER_URL=http://localhost:5001/analyze
PRESIDIO_ANONYMIZER_URL=http://localhost:5002/anonymize
# Local attachment reader (docker compose service attachment-reader). Documents come back as
# text to mask; images and scans come back redacted on this machine, before Gemini sees them.
ATTACHMENT_READER_URL=http://localhost:5003/read
# Model that transcribes the reader's redacted images. Empty disables image transcription; text
# from documents is still read locally.
OCR_MODEL=gemini-3.5-flash-lite
# How often the listener retries quarantined messages (#109) once Presidio is healthy again.
REMASK_INTERVAL=5m
# Skip attachments larger than this. A 20 MB image costs a slow redact and a slow OCR call for
# a screenshot that is usually a signature logo.
OCR_MAX_ATTACHMENT_BYTES=5000000

# ===== Lane B — retrieval + ML =====
# Session pooler URI (NOT the direct db.*.supabase.co host — that is IPv6-only):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
GEMINI_API_KEY=            # embeddings + query reformulation
GEMINI_CHAT_MODEL=         # optional, defaults to gemini-2.5-flash
# How an ambiguous slash date like 05/09/2026 is read: DMY (5 September, the default) or MDY.
# A side over 12 settles it regardless (30/09 and 8/15 each read one way only).
DATE_ORDER=DMY
PRIORITY_MODEL=baseline    # priority classifier: "baseline" (TF-IDF) or "distilbert" (fine-tuned, better)

# ===== Lane C — email agent (generation) =====
GOOGLE_API_KEY=            # Gemini — all agent generation (route, summarize, draft, critic, refine)
# Model for every agent stage. Optional, defaults to gemini-3.5-flash-lite.
GEMINI_AGENT_MODEL=
# Second Gemini model tried when the first fails after its retries or its circuit is open.
# Optional; empty disables the fallback. Same API and key, so masked text goes nowhere new.
GEMINI_FALLBACK_MODEL=
# One time budget for all Gemini calls in a draft. Keep it under the dashboard's 120 s timeout.
AGENT_DEADLINE_SECONDS=100
# Gemini REST base. Optional; only set it to route through a proxy you control.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMAIL_AGENT_URL=http://localhost:8001   # where the backend calls Lane C's /process-email

# ===== Shared / dev =====
# Backend and agent log level (DEBUG, INFO, WARNING). A typo falls back to INFO.
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:8090   # CORS origin for a non-local dashboard (`make web` serves :8090; any localhost port is allowed)

# Backend base URL baked into the dashboard's browser bundle (src/lib/api.ts). Left unset it
# falls back to http://localhost:8000, which the BROWSER resolves — so set this whenever the
# dashboard is opened from anywhere but the machine running the backend (WSL host IP, Tailscale
# name, another device). Keep it commented out rather than blank: api.ts uses `??`, so an empty
# value is not nullish and would override the fallback with an empty string.
# VITE_BACKEND_URL=http://localhost:8000

# ===== Sign-in: dashboard (docs/adr/0005) and admin console (docs/adr/0004) =====
# The project's publishable (anon) key, from Supabase > Project Settings > API. Used server-side
# only, for Google sign-in and the admin password sign-in. Empty means sign-in is refused. SUPABASE_URL above is
# shared; SUPABASE_SERVICE_KEY is used by backend/scripts/admin_accounts.py to grant admin access.
SUPABASE_ANON_KEY=
# Session cookies (dashboard and admin) are Secure. Browsers accept that on localhost; set false
# only when reaching the backend over plain HTTP by LAN address.
ADMIN_COOKIE_SECURE=true
# The dashboard origins allowed to carry the dashboard and admin sessions, comma-separated. Every localhost port
# counts as the same site, so this list, not SameSite, is what keeps another local app (a dev
# server on :8080, say) from reading the admin API with your cookies. Default: :8090, as `make web`.
# Open the dashboard at localhost, not 127.0.0.1: the session cookie does not cross that site boundary.
# ADMIN_ORIGINS=http://localhost:8090
# Where Supabase sends the user back after Google sign-in (add <this>/auth/callback to Supabase >
# Authentication > URL Configuration > Redirect URLs), and where the backend then sends them.
BACKEND_PUBLIC_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:8090

# ===== Script token =====
# Shared bearer token for scripts, tests and curl, so they need no Google sign-in. Server-side only:
# never put it in a VITE_ variable, which would ship it to every browser. Empty means only signed-in
# users get in. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_TOKEN=

# ===== Mailbox owner (optional) =====
# Not needed: at startup the backend asks Gmail which address its login belongs to, and a user
# signed in with that Google account sees the mail (ADR 0005, stage 1). Set this only as a fallback
# for when Gmail cannot be reached at startup. It also keys the per-user policy layer.
# MAILBOX_OWNER_EMAIL=
